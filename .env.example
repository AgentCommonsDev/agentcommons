# Local development. For self-hosting Compose, change database hosts to db.
PUBLIC_URL=http://localhost:5173
# Self-hosting image and updates. Empty runs the latest release,
# ghcr.io/agentcommonsdev/agentcommons:stable, which the updater never moves backwards;
# pin one with its sha-<12 hex> tag or digest, installed as is (older or not).
AGENTCOMMONS_IMAGE=
# The hourly updater (scripts/self-host) installs new releases while this is true.
AUTO_UPDATE=true
INSTANCE_MODE=customer
# SaaS-only monthly organization allowances. Customer/public modes are unmetered.
FREE_MONTHLY_RECORDS=1000
PRO_INCLUDED_RECORDS=10000
# Optional HTTPS Cal.com booking URL for Enterprise inquiries.
# Public demo booking page embedded on the landing page, e.g. https://app.cal.com/agentcommons/demo
CAL_COM_URL=
# Configure the complete price/meter set to enable native Stripe billing in SaaS mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_EMBEDDINGS_PRICE_ID=
STRIPE_CAPTURE_PRICE_ID=
STRIPE_EMBEDDING_USAGE_PRICE_ID=
STRIPE_CAPTURE_METER_ID=
STRIPE_EMBEDDING_METER_ID=
STRIPE_CAPTURE_EVENT_NAME=
STRIPE_EMBEDDING_EVENT_NAME=
CAPTURE_CENTS_PER_1000=
EMBEDDING_CENTS_PER_1000=
POSTGRES_PASSWORD=agentcommons
# Where PostgreSQL runs: bundled (the Compose db service) or external (a managed PostgreSQL 16
# such as Aurora: add docker-compose.external-database.yml to COMPOSE_FILE and point the three
# DATABASE_*_URL values and CLICKHOUSE_POSTGRES_HOST at it, with ?sslmode=require).
AGENTCOMMONS_DATABASE=bundled
DATABASE_MIGRATION_URL=postgres://agentcommons:agentcommons@localhost:5432/agentcommons
DATABASE_URL=postgres://ac_app:app@localhost:5432/agentcommons
DATABASE_TRACE_CONTROL_URL=postgres://ac_trace_control:trace@localhost:5432/agentcommons
# ClickHouse connects to PostgreSQL itself. For Compose use hosts db and clickhouse.
# The native engine uses this hostname from inside the ClickHouse container.
CLICKHOUSE_POSTGRES_HOST=host.docker.internal
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=ac_trace
CLICKHOUSE_MIGRATION_USER=default
CLICKHOUSE_MIGRATION_PASSWORD=local-clickhouse-admin
CLICKHOUSE_WRITER_USER=ac_trace_writer
CLICKHOUSE_WRITER_PASSWORD=local-clickhouse-writer
CLICKHOUSE_ACCESS_USER=ac_trace_access
CLICKHOUSE_ACCESS_PASSWORD=local-clickhouse-access
CLICKHOUSE_READER_SECRET=local-reader-principal-secret-replace-before-hosting
# Generate a unique value with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Enable at least one login method. Bootstrap with pnpm db:seed --admin EMAIL.
AUTH_EMAIL_PASSWORD_ENABLED=true
AUTH_SOCIAL_PROVIDER=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_SCOPES=openid,email,profile
AUTH_ALLOWED_EMAIL_DOMAINS=
AUTH_SIGNUP_MODE=invite
TRUST_PROXY=loopback

REDACTION_EXTRA_PATTERNS=[]
AUDIT_RETENTION_DAYS=365
EMBEDDINGS_ENABLED=false
# Supported providers: openai or fake. OpenAI requires OPENAI_API_KEY when enabled.
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
# V1 vector columns require 1024; changing dimensions needs an operator migration.
EMBEDDINGS_DIMENSIONS=1024
# Hard per-organization UTC-day reservation cap, including query embeddings and retries.
EMBEDDINGS_DAILY_TOKEN_BUDGET=5000000
OPENAI_API_KEY=
SEARCH_CONTEXT_DEFAULT=1
SEARCH_LIMIT_DEFAULT=5
LOG_LEVEL=info

# SaaS email: SMTP captures local delivery; SES requires a verified sender.
EMAIL_TRANSPORT=none
EMAIL_FROM=
SMTP_URL=
