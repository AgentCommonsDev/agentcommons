# Hourly release check with a random delay so many hosts do not pull at the same minute;
# Persistent=true runs a missed check right after boot.
[Unit]
Description=Hourly AgentCommons release check

[Timer]
OnCalendar=hourly
RandomizedDelaySec=15m
Persistent=true
Unit=agentcommons-update.service

[Install]
WantedBy=timers.target
