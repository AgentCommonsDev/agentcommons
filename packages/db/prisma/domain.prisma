enum Harness {
  CLAUDE_CODE
  CODEX
  GEMINI_CLI
  PI
}

enum SessionStatus {
  ACTIVE
  ENDED
  INACTIVE
}

enum ParentRelation {
  SUBAGENT
  FORK
  SPAWNED
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum PolicyKind {
  REGEX
  SECRETLINT_RULE
}

model UsageAdmission {
  organizationId String   @map("organization_id")
  kind           String
  resourceId     String   @map("resource_id") @db.Uuid
  admittedAt     DateTime @map("admitted_at") @db.Timestamptz
  subscriptionId String?  @map("subscription_id")
  periodStart    DateTime @map("period_start") @db.Timestamptz
  periodEnd      DateTime @map("period_end") @db.Timestamptz

  @@id([organizationId, kind, resourceId])
  @@index([organizationId, kind, periodStart])
  @@map("usage_admission")
}

model BillingMeterEvent {
  id                String    @id @db.Uuid
  organizationId    String    @map("organization_id")
  subscriptionId    String    @map("subscription_id")
  customerId        String    @map("customer_id")
  kind              String
  eventName         String    @map("event_name")
  quantity          Int
  occurredAt        DateTime  @map("occurred_at") @db.Timestamptz
  state             String    @default("pending")
  firstDispatchedAt DateTime? @map("first_dispatched_at") @db.Timestamptz
  leaseUntil        DateTime? @map("lease_until") @db.Timestamptz
  deliveredAt       DateTime? @map("delivered_at") @db.Timestamptz
  attempts          Int       @default(0)
  failureCode       String?   @map("failure_code")

  @@index([organizationId, state])
  @@index([state, occurredAt])
  @@map("billing_meter_event")
}

model Installation {
  organizationId String       @map("organization_id")
  id             String       @db.Uuid
  hostname       String
  osUser         String       @map("os_user")
  platform       String
  arch           String
  toolsEnabled   Boolean      @default(true) @map("tools_enabled")
  firstSeenAt    DateTime     @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt     DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz
  auditEvents    AuditEvent[]

  @@id([organizationId, id])
  @@map("installation")
}

model RedactionEvent {
  organizationId String              @map("organization_id")
  ingestBatchId  String              @map("ingest_batch_id") @db.Uuid
  ingestBatch    TraceReceipt        @relation(fields: [organizationId, sessionId, ingestBatchId], references: [organizationId, sessionId, id])
  sessionId      String              @map("session_id") @db.Uuid
  session        TraceSessionControl @relation(fields: [organizationId, sessionId], references: [organizationId, id], onDelete: Cascade)
  policyId       String              @map("policy_id") @db.Uuid
  policy         RedactionPolicy     @relation(fields: [organizationId, policyId], references: [organizationId, id])
  count          Int

  @@id([ingestBatchId, sessionId, policyId])
  @@map("redaction_event")
}

model RedactionPolicy {
  organizationId  String           @map("organization_id")
  id              String           @id @db.Uuid
  name            String
  kind            PolicyKind
  pattern         String?
  flags           String?
  ruleId          String?          @map("rule_id")
  options         Json?
  replacement     String
  enabled         Boolean          @default(true)
  builtin         Boolean          @default(false)
  createdByUserId String?          @map("created_by_user_id")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  events          RedactionEvent[]

  @@unique([organizationId, name])
  @@unique([organizationId, id])
  @@map("redaction_policy")
}

model AuditEvent {
  organizationId  String?           @map("organization_id")
  id              String            @id @db.Uuid
  ts              DateTime          @default(now()) @db.Timestamptz
  requestId       String            @map("request_id")
  userId          String?           @map("user_id")
  apiKeyId        String?           @map("api_key_id")
  installationId  String?           @map("installation_id") @db.Uuid
  installation    Installation?     @relation(fields: [organizationId, installationId], references: [organizationId, id], onDelete: Restrict)
  authMethod      String            @map("auth_method")
  ip              String
  userAgent       String?           @map("user_agent")
  transport       String
  action          String
  resourceType    String?           @map("resource_type")
  resourceIds     String[]          @default([]) @map("resource_ids")
  statusCode      Int               @map("status_code")
  durationMs      Int               @map("duration_ms")
  detail          Json
  traceProjection TraceAuditOutbox?

  @@index([organizationId, ts(sort: Desc)])
  @@index([organizationId, installationId, ts(sort: Desc)])
  @@index([ts(sort: Desc)])
  @@index([userId, ts(sort: Desc)])
  @@index([action, ts(sort: Desc)])
  @@map("audit_event")
}

model ApiKeyOwner {
  keyId          String   @id @map("key_id")
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([organizationId, keyId])
  @@unique([organizationId, keyId, userId])
  @@index([organizationId, userId])
  @@map("api_key_owner")
}

model RedactionRun {
  organizationId    String                @map("organization_id")
  id                String                @db.Uuid
  state             String                @default("queued")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz
  totalSessions     Int                   @map("total_sessions")
  processedSessions Int                   @default(0) @map("processed_sessions")
  redactionCount    Int                   @default(0) @map("redaction_count")
  error             String?
  targets           RedactionRunSession[]

  @@id([organizationId, id])
  @@map("redaction_run")
}

model RedactionRunSession {
  organizationId String              @map("organization_id")
  runId          String              @map("run_id") @db.Uuid
  sessionId      String              @map("session_id") @db.Uuid
  processedAt    DateTime?           @map("processed_at") @db.Timestamptz
  run            RedactionRun        @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: Cascade, map: "redaction_run_session_run_fkey")
  session        TraceSessionControl @relation(fields: [organizationId, sessionId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction, map: "redaction_run_session_session_fkey")

  @@id([organizationId, runId, sessionId])
  @@map("redaction_run_session")
}

model EmbeddingDeployment {
  id         Int    @id
  provider   String
  model      String
  dimensions Int

  @@map("embedding_deployment")
}

model EmbeddingState {
  organizationId String              @map("organization_id")
  sessionId      String              @map("session_id") @db.Uuid
  session        TraceSessionControl @relation(fields: [organizationId, sessionId], references: [organizationId, id], onDelete: Cascade)
  sourceDigest   String              @map("source_digest")
  vectorRevision BigInt              @default(autoincrement()) @map("vector_revision")
  complete       Boolean             @default(false)
  leaseToken     String?             @map("lease_token") @db.Uuid
  leaseUntil     DateTime?           @map("lease_until") @db.Timestamptz
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  @@id([organizationId, sessionId])
  @@map("embedding_state")
}

model EmbeddingBudget {
  organizationId  String             @map("organization_id")
  day             DateTime           @db.Date
  reservedTokens  BigInt             @default(0) @map("reserved_tokens")
  actualTokens    BigInt             @default(0) @map("actual_tokens")
  costNanoDollars BigInt             @default(0) @map("cost_nano_dollars")
  attempts        EmbeddingAttempt[]

  @@id([organizationId, day])
  @@map("embedding_budget")
}

model EmbeddingAttempt {
  organizationId String          @map("organization_id")
  id             String          @id @db.Uuid
  day            DateTime        @db.Date
  budget         EmbeddingBudget @relation(fields: [organizationId, day], references: [organizationId, day])
  purpose        String
  reservedTokens Int             @map("reserved_tokens")
  actualTokens   Int?            @map("actual_tokens")
  state          String          @default("reserved")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz

  @@index([organizationId, day])
  @@map("embedding_attempt")
}

model OrganizationSettings {
  organizationId    String   @id @map("organization_id")
  embeddingsEnabled Boolean  @default(false) @map("embeddings_enabled")
  revision          Int      @default(0)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("organization_settings")
}

model DashboardProfile {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  name           String
  definition     Json
  revision       Int      @default(0)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([organizationId, id])
  @@index([organizationId, userId])
  @@map("dashboard_profile")
}

model TraceSessionControl {
  organizationId             String                @map("organization_id")
  id                         String                @db.Uuid
  harness                    Harness
  nativeIdentity             String                @map("native_identity") @db.VarChar(73)
  harnessSessionId           String                @map("harness_session_id")
  userId                     String                @map("user_id")
  ingestApiKeyId             String                @map("ingest_api_key_id")
  installationId             String                @map("installation_id") @db.Uuid
  acceptedRevision           BigInt                @default(0) @map("accepted_revision")
  publishedRevision          BigInt                @default(0) @map("published_revision")
  redactionGeneration        BigInt                @default(0) @map("redaction_generation")
  redactionCleanedGeneration BigInt                @default(0) @map("redaction_cleaned_generation")
  embeddingRevision          BigInt?               @map("embedding_revision")
  embeddingSourceRevision    BigInt?               @map("embedding_source_revision")
  visibility                 Visibility            @default(PUBLIC)
  status                     SessionStatus         @default(ACTIVE)
  lifecyclePos               BigInt?               @map("lifecycle_pos")
  lifecycleAt                DateTime?             @map("lifecycle_at") @db.Timestamptz
  contextPos                 BigInt?               @map("context_pos")
  contextAt                  DateTime?             @map("context_at") @db.Timestamptz
  normalizerContext          Json                  @default("{}") @map("normalizer_context")
  projectedContext           Json                  @default("{}") @map("projected_context")
  startedAt                  DateTime              @map("started_at") @db.Timestamptz
  endedAt                    DateTime?             @map("ended_at") @db.Timestamptz
  lastActivityAt             DateTime              @map("last_activity_at") @db.Timestamptz
  parentSessionId            String?               @map("parent_session_id") @db.Uuid
  parentRelation             ParentRelation?       @map("parent_relation")
  parentNativeRef            String?               @map("parent_native_ref")
  purgedAt                   DateTime?             @map("purged_at") @db.Timestamptz
  purgedByUserId             String?               @map("purged_by_user_id")
  purgeReason                String?               @map("purge_reason")
  purgeManifest              Json?                 @map("purge_manifest")
  purgeCompletedAt           DateTime?             @map("purge_completed_at") @db.Timestamptz
  projectionLease            String?               @map("projection_lease") @db.Uuid
  projectionLeaseUntil       DateTime?             @map("projection_lease_until") @db.Timestamptz
  projectionState            String                @default("queued") @map("projection_state")
  projectionError            String?               @map("projection_error")
  projectionAttemptAt        DateTime?             @map("projection_attempt_at") @db.Timestamptz
  redactionEvents            RedactionEvent[]
  rescanTargets              RedactionRunSession[]
  embeddingState             EmbeddingState?

  @@id([organizationId, id])
  @@unique([organizationId, harness, nativeIdentity])
  @@index([organizationId, publishedRevision])
  @@map("trace_session_control")
}

model TraceSourceAdmission {
  organizationId     String   @map("organization_id")
  sessionId          String   @map("session_id") @db.Uuid
  sourceIdentity     String   @map("source_identity") @db.VarChar(64)
  rawRecordId        String   @map("raw_record_id") @db.Uuid
  pos                BigInt
  sourceVersion      Int      @map("source_version")
  introducedRevision BigInt   @map("introduced_revision")
  receivedAt         DateTime @map("received_at") @db.Timestamptz

  @@id([organizationId, sessionId, sourceIdentity])
  @@unique([organizationId, rawRecordId])
  @@map("trace_source_admission")
}

model TraceOutbox {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id")
  sessionId      String   @map("session_id") @db.Uuid
  revision       BigInt
  kind           String
  payload        Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([organizationId, sessionId, revision])
  @@index([createdAt])
  @@map("trace_outbox")
}

model TraceReceipt {
  organizationId   String           @map("organization_id")
  id               String           @db.Uuid
  sessionId        String           @map("session_id") @db.Uuid
  installationId   String           @map("installation_id") @db.Uuid
  apiKeyId         String           @map("api_key_id")
  userId           String           @map("user_id")
  revision         BigInt
  sourcePos        BigInt           @map("source_pos")
  sentAt           DateTime         @map("sent_at") @db.Timestamptz
  receivedAt       DateTime         @map("received_at") @db.Timestamptz
  publishedAt      DateTime?        @map("published_at") @db.Timestamptz
  behavior         String
  nativeEvent      String           @map("native_event")
  startResume      Boolean          @map("start_resume")
  lifecycleApplied Boolean          @map("lifecycle_applied")
  acceptedCount    Int              @map("accepted_count")
  duplicateCount   Int              @map("duplicate_count")
  recordCount      Int              @map("record_count")
  byteCount        BigInt           @map("byte_count")
  redactionCount   Int              @map("redaction_count")
  durationMs       Int              @map("duration_ms")
  cursor           String
  redactions       RedactionEvent[]

  @@id([organizationId, id])
  @@unique([organizationId, sessionId, id])
  @@index([organizationId, sessionId, sourcePos])
  @@index([organizationId, apiKeyId, receivedAt])
  @@map("trace_receipt")
}

model TraceToolCallControl {
  organizationId String  @map("organization_id")
  sessionId      String  @map("session_id") @db.Uuid
  idHash         String  @map("id_hash") @db.VarChar(64)
  sensitive      Boolean

  @@id([organizationId, sessionId, idHash])
  @@map("trace_tool_call_control")
}

model TraceAuditOutbox {
  auditId   String     @id @map("audit_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  audit     AuditEvent @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([createdAt, auditId])
  @@map("trace_audit_outbox")
}

model TraceAnalyticsRetention {
  id            Int      @id
  retainedAfter DateTime @map("retained_after") @db.Timestamptz

  @@map("trace_analytics_retention")
}
