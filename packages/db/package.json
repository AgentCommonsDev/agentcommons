{
  "name": "@agentcommons/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./auth-plugins": "./src/auth-plugins.ts"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run --root ../.. packages/db/test",
    "db:generate": "prisma generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "db:auth-generate": "auth generate --adapter prisma --dialect postgresql --config ./auth-schema.ts --output ./prisma/auth.prisma --yes",
    "generate": "prisma generate",
    "validate": "DATABASE_URL=${DATABASE_URL:-postgresql://schema:validation@127.0.0.1:1/agentcommons} prisma validate",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "diff": "vitest run --root ../.. packages/db/test/database.integration.test.ts -t \"keeps Prisma-owned schema in sync\""
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "pg": "^8.16.3",
    "pg-boss": "^10.4.2",
    "zod": "4.5.4",
    "@better-auth/api-key": "1.7.3",
    "better-auth": "1.7.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.10.0",
    "@types/pg": "^8.15.6",
    "auth": "1.7.3",
    "prisma": "6.19.0"
  },
  "prisma": {
    "schema": "./prisma"
  }
}
