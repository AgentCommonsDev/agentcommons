{
  "name": "@agentcommons/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx src/main.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "recover": "tsx --env-file-if-exists=../../.env src/recover.ts",
    "openapi:generate": "tsx src/openapi.ts",
    "openapi:check": "tsx src/openapi.ts --check"
  },
  "dependencies": {
    "@agentcommons/core": "workspace:*",
    "@agentcommons/db": "workspace:*",
    "@fastify/compress": "^8.1.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^5.2.3",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@t3-oss/env-core": "^0.13.10",
    "better-auth": "1.7.3",
    "fastify": "^5.7.4",
    "fastify-type-provider-zod": "^7.0.0",
    "js-tiktoken": "^1.0.21",
    "openai": "^6.22.0",
    "pg": "^8.16.3",
    "pg-boss": "^10.4.2",
    "pgsql-ast-parser": "^12.0.1",
    "pino": "^9.14.0",
    "qs": "^6.15.0",
    "tsx": "^4.21.0",
    "uuid": "^11.1.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/qs": "^6.14.0",
    "yaml": "^2.9.0"
  }
}
