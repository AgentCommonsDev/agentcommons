{
  "name": "@agentcommons/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist/prerender && node scripts/generate-public.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:workspace": "pnpm build && pnpm test:workspace:built",
    "test:browser": "pnpm build && pnpm test:browser:built",
    "api:generate": "node scripts/generate-client.mjs && node scripts/generate-options.mjs && prettier --write src/lib/api/generated.ts src/lib/api/options.ts",
    "test:browser:built": "playwright test -c playwright.config.ts",
    "test:workspace:built": "playwright test -c playwright.workspace.config.ts"
  },
  "dependencies": {
    "@agentcommons/core": "workspace:*",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@shikijs/langs": "3.23.0",
    "@shikijs/themes": "3.23.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.159.5",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.18",
    "better-auth": "1.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "openapi-fetch": "^0.17.0",
    "papaparse": "^5.5.3",
    "qs": "^6.16.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.23.0",
    "tailwind-merge": "^3.5.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/papaparse": "^5.5.2",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "jose": "6.1.3",
    "oidc-provider": "9.12.2",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.1"
  }
}
