{
  "name": "@agentcommons/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-blog.mjs && vite --host 0.0.0.0",
    "build": "node scripts/generate-blog.mjs && tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist/prerender && node scripts/generate-public.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:workspace": "pnpm build && pnpm test:workspace:built",
    "test:browser": "pnpm build && pnpm test:browser:built",
    "api:generate": "node scripts/generate-client.mjs && node scripts/generate-options.mjs && prettier --write src/lib/api/generated.ts src/lib/api/options.ts",
    "test:browser:built": "playwright test -c playwright.config.ts",
    "test:workspace:built": "playwright test -c playwright.workspace.config.ts",
    "test:saas:built": "playwright test -c playwright.saas.config.ts",
    "test:saas": "pnpm build && pnpm test:saas:built",
    "screenshots": "node scripts/readme-screenshots.mjs"
  },
  "dependencies": {
    "@agentcommons/core": "workspace:*",
    "@calcom/embed-react": "1.5.3",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@shikijs/langs": "3.23.0",
    "@shikijs/themes": "3.23.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "1.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lucide-react": "^0.577.0",
    "openapi-fetch": "^0.17.0",
    "qs": "^6.16.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-grid-layout": "^2.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.23.0",
    "tailwind-merge": "^3.5.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "gray-matter": "^4.0.3",
    "jose": "6.2.12",
    "oidc-provider": "9.12.2",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.1"
  }
}
