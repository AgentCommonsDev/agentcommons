{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.{ts,mjs}",
        "scripts/recall-bench/*.ts",
        "*.config.{ts,js}",
        "e2e/**/*.test.ts"
      ]
    },
    "apps/api": { "entry": ["test/**/*.test.ts"] },
    "apps/dashboard": {
      "entry": [
        "src/entry-server.tsx",
        "scripts/*.mjs",
        "tests/public-api-stub.mjs"
      ]
    },
    "packages/db": { "entry": ["auth-schema.ts", "test/**/*.test.ts"] },
    "packages/traces": { "entry": ["test/**/*.test.ts"] },
    "packages/hook": {
      "entry": ["src/entry.ts", "test/**/*.test.ts", "test/kill-worker.ts"]
    },
    "packages/pi-extension": { "entry": ["src/index.ts"] },
    "infra": {
      "entry": ["index.ts", "scripts/*.ts", "test/**/*.test.ts"],
      "ignoreDependencies": ["tsx"],
      "ignoreBinaries": ["pulumi"]
    }
  }
}
