# Caddy in front of the API on one host (docker-compose.caddy.yml).
# PUBLIC_URL, for example https://hooks.tools.goodhartlabs.com, comes from .env; Caddy
# obtains and renews its certificate automatically once DNS resolves to this host and
# keeps retrying until then. The plain http:// site answers on the bare address so the
# host can be checked before DNS exists; requests for the public hostname on port 80
# are redirected to HTTPS by Caddy's automatic HTTPS.
# entrypoint.sh fills CADDY_TRUSTED_PROXIES (Cloudflare's published ranges by default,
# nothing for "none", or a literal list) and CADDY_CLIENT_IP_HEADER (CF-Connecting-IP in
# Cloudflare mode, X-Forwarded-For otherwise). Trusted proxies' X-Forwarded-Proto is
# honoured and the client address is taken from that header, so the API always receives
# the real client address in X-Forwarded-For and needs no change between modes.
{
	servers {
		protocols h1 h2
		trusted_proxies static {$CADDY_TRUSTED_PROXIES}
		client_ip_headers {$CADDY_CLIENT_IP_HEADER}
	}
}

{$PUBLIC_URL} {
	encode zstd gzip
	reverse_proxy api:3000 {
		header_up X-Forwarded-For {client_ip}
	}
}

http:// {
	reverse_proxy api:3000 {
		header_up X-Forwarded-For {client_ip}
	}
}
